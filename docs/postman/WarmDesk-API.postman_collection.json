{
  "info": {
    "name": "WarmDesk API",
    "description": "Postman mirror of docs/bruno. Import the matching environment (WarmDesk Local or WarmDesk Production), run Login \u2014 the test script saves access_token as `token` on the active environment (same behaviour as the Bruno Login post-response script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
