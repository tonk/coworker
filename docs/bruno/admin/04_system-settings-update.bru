meta {
  name: Update System Settings (Admin)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admin/system
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "company_name": "ACME Corp",
    "registration_enabled": true,
    "smtp_host": "mail.example.com",
    "smtp_port": 587,
    "smtp_from": "noreply@example.com",
    "session_timeout_minutes": 60
  }
}
