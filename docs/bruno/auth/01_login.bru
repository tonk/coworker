meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.access_token) {
    bru.setVar("token", res.body.access_token);
  }
}

docs {
  Logs in and automatically stores the access_token in the token environment variable.
  If MFA is enabled, the response contains mfa_required: true and an mfa_token — use
  the MFA Verify request to complete login.
}
