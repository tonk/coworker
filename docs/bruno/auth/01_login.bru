meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{username}}",
    "password": "{{password}}"
  }
}

docs {
  Returns access_token and refresh_token.
  Copy the access_token into the token environment variable.
  If MFA is enabled, use the returned mfa_token with the MFA Verify request instead.
}
