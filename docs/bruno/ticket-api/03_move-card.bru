meta {
  name: Move Card (Ticket API)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/ticket/{{projectSlug}}/cards/{{cardId}}/move
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "column": "Done"
  }
}

docs {
  Move card by column name. Used in CI/CD pipelines to close cards on deploy.
}
