meta {
  name: Create SLA Policy (Admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/sla-policies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Critical 1h/4h",
    "response_time_minutes": 60,
    "resolution_time_minutes": 240,
    "priority_filter": "critical",
    "is_active": true
  }
}

docs {
  priority_filter: comma-separated priorities this policy applies to (e.g. "high,critical").
  Leave empty to match all priorities (catch-all).
  More specific policies are matched before catch-all policies.
}
