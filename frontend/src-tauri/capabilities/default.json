{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/capability.json",
  "identifier": "default",
  "description": "Default capability — allows the app to connect to any external server URL.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "https://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://127.0.0.1:*" }
      ]
    },
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    "opener:default",
    "notification:default"
  ]
}
