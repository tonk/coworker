{
  "productName": "WarmDesk",
  "version": "0.12.15",
  "identifier": "com.warmdesk.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Self-hosted Kanban and Scrum boards, team chat, and time tracking",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "warmdesk.desktop"
      },
      "rpm": {
        "depends": [],
        "desktopTemplate": "warmdesk.desktop"
      }
    }
  }
}
