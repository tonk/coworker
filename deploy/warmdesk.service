[Unit]
Description=WarmDesk Kanban
Documentation=https://github.com/tonk/warmdesk
After=network.target

[Service]
# Type=notify: the binary calls sd_notify(READY=1) itself once it has
# successfully bound its HTTP listener, so `systemctl start warmdesk`
# blocks until startup actually succeeds (or fails) instead of reporting
# success the instant the process is forked — matching how `systemctl
# start nginx` reports a failed start immediately.
Type=notify
User=warmdesk
Group=warmdesk
WorkingDirectory=/opt/warmdesk

ExecStart=/opt/warmdesk/warmdesk
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Environment — adjust to your setup
Environment=PORT=8080
Environment=DB_DRIVER=sqlite
Environment=DB_DSN=/opt/warmdesk/data/warmdesk.db
Environment=JWT_SECRET=change-me-to-a-random-secret
Environment=ALLOWED_ORIGINS=https://yourdomain.com
Environment=WEB_DIR=/opt/warmdesk/web
Environment=UPLOAD_DIR=/opt/warmdesk/uploads

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/warmdesk/data /opt/warmdesk/uploads

[Install]
WantedBy=multi-user.target
