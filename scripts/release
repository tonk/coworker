#!/usr/bin/env bash
#
# WarmDesk release helper — bump version strings, refresh Rust lockfile, optional git tag/push.
#
# Typical flow (see docs/release.md):
#   1. Write CHANGELOG.md section and README "Latest release" bullets by hand.
#   2. ./scripts/release bump v0.9.40
#   3. Review diff, commit, tag, push (or use: ./scripts/release publish v0.9.40).
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

die() { echo "release: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  release help | --help | -h          Show this help.
  release bump <version>              Bump version metadata (see docs/release.md).
  release check [<version>]            Verify version strings in tree (optional: expected tag).
  release publish <version>           bump + git commit + annotated tag + push main + push tag.

  release <version>                   Same as: release bump <version>

<version> may be v0.9.40 or 0.9.40 (semver x.y.z).

Options (before subcommand):
  --dry-run                           Print actions only; do not modify files.

Environment:
  RELEASE_DATE                        Override ISO date for website/hugo.toml (default: today UTC).

Examples:
  ./scripts/release bump v0.9.40
  ./scripts/release --dry-run bump 0.9.40
  ./scripts/release publish v0.9.40
EOF
}

DRY_RUN=0
while [[ "${1:-}" == --dry-run ]]; do DRY_RUN=1; shift; done

normalize_tag() {
  local in="${1:?}"
  if [[ "$in" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "$in"
  elif [[ "$in" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "v$in"
  else
    die "invalid version '$in' — use v0.9.40 or 0.9.40"
  fi
}

bare_version() {
  local v="$1"
  echo "${v#v}"
}

cmd_bump() {
  local tag_raw="${1:?}"
  local V_TAG
  V_TAG="$(normalize_tag "$tag_raw")"
  local BARE
  BARE="$(bare_version "$V_TAG")"
  local REL_DATE
  REL_DATE="${RELEASE_DATE:-$(date -u +%F)}"

  local files=(
    "website/hugo.toml"
    "frontend/src-tauri/tauri.conf.json"
    "frontend/src-tauri/Cargo.toml"
    "README.md"
  )

  echo "→ Release tag:  $V_TAG  (desktop package: $BARE)"
  echo "→ Website date: $REL_DATE (UTC; override with RELEASE_DATE=...)"
  echo ""

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "[dry-run] would edit:"
    printf '   %s\n' "${files[@]}"
    echo "[dry-run] would run: (cd frontend/src-tauri && cargo metadata --format-version 1 > /dev/null)"
    echo "[dry-run] then: remind you to update CHANGELOG.md + README bullets if not done yet."
    return 0
  fi

  # website/hugo.toml — keep AsciiDoc attribute in sync with params (comment in file).
  sed -i \
    -e "s/^  warmdesk_version = \".*\"/  warmdesk_version = \"${V_TAG}\"/" \
    -e "s/^  release_date     = \".*\"/  release_date     = \"${REL_DATE}\"/" \
    -e "s/\"warmdesk-version\" = \".*\"/\"warmdesk-version\" = \"${V_TAG}\"/" \
    "website/hugo.toml"

  # Tauri app metadata (semver without "v").
  sed -i \
    -e "s/\"version\": \"[0-9.]*\"/\"version\": \"${BARE}\"/" \
    "frontend/src-tauri/tauri.conf.json"
  sed -i \
    -e "s/^version = \"[0-9.]*\"/version = \"${BARE}\"/" \
    "frontend/src-tauri/Cargo.toml"

  # README — only the "## Latest release (vX.Y.Z)" heading; you edit bullets below separately.
  sed -i \
    -e "s/^## Latest release (v[0-9.]*)/## Latest release (${V_TAG})/" \
    "README.md"

  echo "→ Refreshing Rust lockfile (cargo metadata)…"
  (cd frontend/src-tauri && cargo metadata --format-version 1 > /dev/null)

  echo ""
  echo "✓ Bumped mechanical version fields."
  echo ""
  echo "Manual checklist (if not done yet):"
  echo "  • CHANGELOG.md — add ## ${V_TAG} — ${REL_DATE} with Added/Fixed/Changed entries"
  echo "  • README.md — bullet list under Latest release (heading was updated)"
  echo "  • git add, commit, tag, push — or run: ./scripts/release publish ${V_TAG}"
}

cmd_check() {
  local expect="${1:-}"
  echo "Scanning known files for version strings…"
  grep -n -E 'warmdesk_version|warmdesk-version|"version":|^version = |Latest release' \
    website/hugo.toml frontend/src-tauri/tauri.conf.json frontend/src-tauri/Cargo.toml README.md 2>/dev/null || true
  if [[ -n "$expect" ]]; then
    local V
    V="$(normalize_tag "$expect")"
    echo ""
    echo "Expected tag: $V"
    grep -F -- "$V" website/hugo.toml README.md || true
    grep -F -- "$(bare_version "$V")" frontend/src-tauri/tauri.conf.json frontend/src-tauri/Cargo.toml || true
  fi
}

cmd_publish() {
  local tag_raw="${1:?}"
  local V_TAG
  V_TAG="$(normalize_tag "$tag_raw")"
  cmd_bump "$tag_raw"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "[dry-run] would: git add -A && git commit && git tag && push"
    return 0
  fi
  if ! git diff --quiet || ! git diff --cached --quiet; then
    :
  fi
  git add -A
  git commit -m "$(cat <<EOF
Release ${V_TAG}

See CHANGELOG.md for details.
EOF
)" || die "commit failed (nothing to commit?)"
  git tag -a "${V_TAG}" -m "WarmDesk ${V_TAG}"
  git push origin main
  git push origin "${V_TAG}"
  echo "✓ Pushed main and tag ${V_TAG}"
}

# --- dispatch ---
SUB="${1:-}"
case "$SUB" in
  ''|help|-h|--help|-\?) usage ;;
  check) shift; cmd_check "${1:-}" ;;
  bump)
    shift
    [[ -n "${1:-}" ]] || die "bump: version required"
    cmd_bump "$1"
    ;;
  publish)
    shift
    [[ -n "${1:-}" ]] || die "publish: version required"
    cmd_publish "$1"
    ;;
  *)
    if [[ "$SUB" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      cmd_bump "$SUB"
    else
      die "unknown command '$SUB' — try: ./scripts/release help"
    fi
    ;;
esac
